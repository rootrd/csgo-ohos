+    return query;
   }
 
 
+  void DxvkContext::profilePassBegin() {
+    PassProfileMark& mark = m_passProfileCurrent.passes.emplace_back();
+    mark.begin = profileTimestamp();
+
+    // Fragment invocations against the render area show overdraw. The query
+    // becomes active with the other statistics queries when the pass begins.
+    if (m_device->features().core.features.pipelineStatisticsQuery) {
+      mark.stats = m_device->createGpuQuery(VK_QUERY_TYPE_PIPELINE_STATISTICS, 0, 0);
+      m_queryManager.enableQuery(m_cmd, mark.stats);
+    }
+    m_passProfileDrawBase = m_cmd->statCounters().getCtr(DxvkStatCounter::CmdDrawCalls);
+  }
+
+
+  void DxvkContext::profilePassEnd() {
+    if (m_passProfileCurrent.passes.empty() || m_passProfileCurrent.passes.back().end != nullptr)
+      return;
+
+    PassProfileMark& mark = m_passProfileCurrent.passes.back();
+
+    profileShaderEnd();
+
+    if (mark.stats != nullptr)
+      m_queryManager.disableQuery(m_cmd, mark.stats);
+
+    mark.end = profileTimestamp();
+    mark.draws = m_cmd->statCounters().getCtr(DxvkStatCounter::CmdDrawCalls) - m_passProfileDrawBase;
+
+    // Label: render area, then format / load op / store op of each attachment.
+    // Load: L=load C=clear D=dont-care N=none; store: S=store D=dont-care N=none.
+    auto loadOp = [] (VkAttachmentLoadOp op) {
+      return op == VK_ATTACHMENT_LOAD_OP_LOAD ? 'L' : op == VK_ATTACHMENT_LOAD_OP_CLEAR ? 'C'
+           : op == VK_ATTACHMENT_LOAD_OP_DONT_CARE ? 'D' : 'N';
+    };
+    auto storeOp = [] (VkAttachmentStoreOp op) {
+      return op == VK_ATTACHMENT_STORE_OP_STORE ? 'S' : op == VK_ATTACHMENT_STORE_OP_DONT_CARE ? 'D' : 'N';
+    };
+
+    const auto& rendering = m_state.om.renderingInfo.rendering;
+    std::string label = str::format(rendering.renderArea.extent.width, "x", rendering.renderArea.extent.height,
+      "+", rendering.renderArea.offset.x, ",", rendering.renderArea.offset.y);
+
+    for (uint32_t i = 0; i < MaxNumRenderTargets; i++) {
+      const DxvkAttachment& target = m_state.om.framebufferInfo.getColorTarget(i);
+
+      if (target.view == nullptr)
+        continue;
+
+      const auto& attachment = m_state.om.renderingInfo.color[i];
+      VkExtent3D extent = target.view->image()->info().extent;
+      label += str::format(" C", i, ":f", uint32_t(target.view->info().format), ":",
+        extent.width, "x", extent.height, ":", loadOp(attachment.loadOp), storeOp(attachment.storeOp),
+        attachment.resolveMode != VK_RESOLVE_MODE_NONE ? "R" : "");
+    }
+
+    const DxvkAttachment& depth = m_state.om.framebufferInfo.getDepthTarget();
+
+    if (depth.view != nullptr) {
+      const auto& d = m_state.om.renderingInfo.depth;
+      const auto& st = m_state.om.renderingInfo.stencil;
+      VkExtent3D extent = depth.view->image()->info().extent;
+      label += str::format(" D:f", uint32_t(depth.view->info().format), ":", extent.width, "x", extent.height,
+        ":", loadOp(d.loadOp), storeOp(d.storeOp), "/", loadOp(st.loadOp), storeOp(st.storeOp));
+    }
+
+    mark.label = std::move(label);
+    mark.endedBy = profileBacktrace();
+  }
