   void DxvkContext::writeTimestamp(const Rc<DxvkQuery>& query) {
+#ifdef __ANDROID__
+    // Mobile tilers may defer the actual rendering until the end of the pass.
+    // Place timestamps outside the render pass, without submitting the command
