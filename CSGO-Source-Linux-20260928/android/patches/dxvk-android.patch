+#ifdef __ANDROID__
+  // Return addresses of the code ending a render pass, as library+offset, so
+  // they can be symbolized offline against the unstripped libraries.
+  static std::string profileBacktrace() {
+    struct State { uintptr_t frames[12]; uint32_t count; } state = { { }, 0u };
+
+    _Unwind_Backtrace([] (_Unwind_Context* context, void* data) {
+      auto state = static_cast<State*>(data);
+      uintptr_t pc = _Unwind_GetIP(context);
+
+      if (pc && state->count < 12u)
+        state->frames[state->count++] = pc;
+
+      return state->count < 12u ? _URC_NO_REASON : _URC_END_OF_STACK;
+    }, &state);
+
+    std::string result;
+
+    for (uint32_t i = 2u; i < state.count; i++) {
+      Dl_info info = { };
+
+      if (!dladdr(reinterpret_cast<void*>(state.frames[i]), &info) || !info.dli_fname)
+        continue;
+
+      const char* name = std::strrchr(info.dli_fname, '/');
+      result += str::format(i > 2u ? " " : "", name ? name + 1 : info.dli_fname, "+0x",
+        std::hex, state.frames[i] - reinterpret_cast<uintptr_t>(info.dli_fbase) - 1u);
+    }
+
+    return result;
+  }
+
