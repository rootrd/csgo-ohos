+  void DxvkContext::profileShaderDraw() {
+    if (!m_device->features().core.features.pipelineStatisticsQuery || m_passProfileCurrent.passes.empty())
+      return;
+
+    auto& shaders = m_passProfileCurrent.passes.back().shaders;
+    const auto& current = m_state.gp.shaders.fs;
+    if (!shaders.empty() && !shaders.back().ended && shaders.back().shader == current)
+      return;
+
+    profileShaderEnd();
+    ShaderProfileMark& mark = shaders.emplace_back();
+    mark.shader = current;
+    mark.stats = m_device->createGpuQuery(VK_QUERY_TYPE_PIPELINE_STATISTICS, 0, 0);
+    mark.draws = m_cmd->statCounters().getCtr(DxvkStatCounter::CmdDrawCalls);
+    // These query boundaries remain inside the existing render pass. The
+    // counts diagnose fragment work; their instrumented timings are not FPS.
+    m_queryManager.enableQuery(m_cmd, mark.stats);
