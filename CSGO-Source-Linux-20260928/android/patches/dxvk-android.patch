+  bool DxvkContext::profileResolveFrame(const PassProfileFrame& frame) {
+    auto time = [] (const Rc<DxvkQuery>& query, uint64_t& value) {
+      DxvkQueryData data = { };
+      DxvkGpuQueryStatus status = query->getData(data);
+      value = data.timestamp.time;
+      return status;
+    };
+
+    std::vector<uint64_t> stamps;
+    stamps.reserve(2u * frame.passes.size() + 2u);
+
+    std::vector<const Rc<DxvkQuery>*> queries = { &frame.start };
+
+    for (const auto& pass : frame.passes) {
+      queries.push_back(&pass.begin);
+      queries.push_back(&pass.end);
+    }
+
+    for (const auto& pass : frame.passes) {
+      DxvkQueryData data = { };
+
+      if (pass.stats != nullptr && pass.stats->getData(data) == DxvkGpuQueryStatus::Pending)
+        return false;
+
+      for (const auto& shader : pass.shaders) {
+        if (shader.stats->getData(data) == DxvkGpuQueryStatus::Pending)
+          return false;
+      }
+    }
+
+    queries.push_back(&frame.end);
+
+    bool valid = true;
+
+    for (auto query : queries) {
+      uint64_t value = 0u;
+
+      if (*query == nullptr) {
+        valid = false;
+        continue;
+      }
+
+      DxvkGpuQueryStatus status = time(*query, value);
+
+      if (status == DxvkGpuQueryStatus::Pending)
+        return false;
+
+      valid &= status == DxvkGpuQueryStatus::Available;
+      stamps.push_back(value);
+    }
+
+    if (!valid || (!m_passProfileStats.empty() && m_passProfileStats.size() != frame.passes.size())) {
+      m_passProfileMismatched += 1u;
+      return true;
+    }
+
+    double period = double(m_device->adapter()->deviceProperties().limits.timestampPeriod) * 1e-6;
+
+    if (m_passProfileStats.empty()) {
+      m_passProfileStats.resize(frame.passes.size());
+
+      for (size_t i = 0; i < frame.passes.size(); i++) {
+        m_passProfileStats[i].label = frame.passes[i].label;
+        m_passProfileStats[i].endedBy = frame.passes[i].endedBy;
+      }
+    }
+
+    for (size_t i = 0; i < frame.passes.size(); i++) {
+      if (frame.passes[i].stats != nullptr) {
+        DxvkQueryData data = { };
+
+        if (frame.passes[i].stats->getData(data) == DxvkGpuQueryStatus::Available) {
+          m_passProfileStats[i].vsInvocations += double(data.statistic.vsInvocations);
+          m_passProfileStats[i].iaPrimitives += double(data.statistic.iaPrimitives);
+          m_passProfileStats[i].clipInvocations += double(data.statistic.clipInvocations);
+          m_passProfileStats[i].primitives += double(data.statistic.clipPrimitives);
+          m_passProfileStats[i].fsInvocations += double(data.statistic.fsInvocations);
+        }
+      }
+
+      m_passProfileStats[i].gapMs += double(stamps[2u * i + 1u] - stamps[2u * i]) * period;
+      m_passProfileStats[i].passMs += double(stamps[2u * i + 2u] - stamps[2u * i + 1u]) * period;
+      m_passProfileStats[i].draws += double(frame.passes[i].draws);
+
+      for (const auto& shader : frame.passes[i].shaders) {
+        DxvkQueryData data = { };
+        if (shader.stats->getData(data) != DxvkGpuQueryStatus::Available)
+          continue;
+        std::string name = shader.shader != nullptr ? shader.shader->debugName() : "none";
+        auto& stat = m_passProfileStats[i].shaders[name];
+        stat.draws += double(shader.draws);
+        stat.vs += double(data.statistic.vsInvocations);
+        stat.ia += double(data.statistic.iaPrimitives);
+        stat.fs += double(data.statistic.fsInvocations);
+      }
+    }
+
+    m_passProfileTailMs += double(stamps.back() - stamps[stamps.size() - 2u]) * period;
+    m_passProfileFrameMs += double(stamps.back() - stamps.front()) * period;
+    m_passProfileFrames += 1u;
+    return true;
+  }
+
+
+  void DxvkContext::profileReport() {
+    const char* tag = "CSGO-DXVK-Passes";
+    double n = std::max(1.0, double(m_passProfileFrames));
+    double passTotal = 0.0, gapTotal = m_passProfileTailMs;
+
+    for (const auto& stat : m_passProfileStats) {
+      passTotal += stat.passMs;
+      gapTotal += stat.gapMs;
+    }
+
+    __android_log_print(ANDROID_LOG_INFO, tag,
+      "[pass profile] tag=%s frames=%u mismatched=%u passes=%zu frame_ms=%.4f pass_ms=%.4f gap_ms=%.4f",
+      m_passProfileTag.c_str(), m_passProfileFrames, m_passProfileMismatched, m_passProfileStats.size(),
+      m_passProfileFrameMs / n, passTotal / n, gapTotal / n);
+
+    for (size_t i = 0; i < m_passProfileStats.size(); i++) {
+      const auto& stat = m_passProfileStats[i];
+      __android_log_print(ANDROID_LOG_INFO, tag,
+        "[pass profile] tag=%s #%zu gap_ms=%.4f pass_ms=%.4f draws=%.1f vs=%.0f ia=%.0f clip_in=%.0f prims=%.0f fs=%.0f %s",
+        m_passProfileTag.c_str(), i, stat.gapMs / n, stat.passMs / n, stat.draws / n,
+        stat.vsInvocations / n, stat.iaPrimitives / n, stat.clipInvocations / n,
+        stat.primitives / n, stat.fsInvocations / n, stat.label.c_str());
+      __android_log_print(ANDROID_LOG_INFO, tag,
+        "[pass profile] tag=%s #%zu ended_by %s", m_passProfileTag.c_str(), i, stat.endedBy.c_str());
+
+      for (const auto& shader : stat.shaders) {
+        __android_log_print(ANDROID_LOG_INFO, tag,
+          "[pass profile] tag=%s #%zu shader=%s draws=%.1f vs=%.0f ia=%.0f fs=%.0f",
+          m_passProfileTag.c_str(), i, shader.first.c_str(), shader.second.draws / n,
+          shader.second.vs / n, shader.second.ia / n, shader.second.fs / n);
+      }
+    }
+
+    __android_log_print(ANDROID_LOG_INFO, tag, "[pass profile] tag=%s tail_gap_ms=%.4f end",
+      m_passProfileTag.c_str(), m_passProfileTailMs / n);
+  }
+
+
+  void DxvkContext::profileRenderPassFrame() {
+    char value[PROP_VALUE_MAX] = { };
+    __system_property_get("debug.csgo.dxvk_passes", value);
+
+    if (m_passProfileProperty != value) {
+      m_passProfileProperty = value;
+
+      std::string text = value;
+      size_t separator = text.find(':');
+      uint32_t frames = uint32_t(std::strtoul(text.c_str(), nullptr, 10));
+
+      if (frames && !m_passProfileRemaining && m_passProfilePending.empty()) {
+        char shaderStats[PROP_VALUE_MAX] = { };
+        __system_property_get("debug.csgo.dxvk_shader_stats", shaderStats);
+        m_passProfileShaderStats = shaderStats[0] == '1';
+        m_passProfileTag = separator != std::string::npos ? text.substr(separator + 1u) : std::string();
+        m_passProfileWanted = std::min(frames, 600u);
+        m_passProfileRemaining = m_passProfileWanted;
+        m_passProfileFrames = 0u;
+        m_passProfileMismatched = 0u;
+        m_passProfileTailMs = 0.0;
+        m_passProfileFrameMs = 0.0;
+        m_passProfileStats.clear();
+        m_passProfileCurrent = PassProfileFrame();
+        m_passProfileCurrent.start = profileTimestamp();
+        return;
+      }
+    }
+
+    if (m_passProfileRemaining) {
+      m_passProfileCurrent.end = profileTimestamp();
+      Rc<DxvkQuery> next = m_passProfileCurrent.end;
+      m_passProfilePending.push_back(std::move(m_passProfileCurrent));
+      m_passProfileCurrent = PassProfileFrame();
+
+      if (--m_passProfileRemaining)
+        m_passProfileCurrent.start = next;
+    }
+
+    size_t resolved = 0u;
+
+    while (resolved < m_passProfilePending.size() && profileResolveFrame(m_passProfilePending[resolved]))
+      resolved += 1u;
+
+    m_passProfilePending.erase(m_passProfilePending.begin(), m_passProfilePending.begin() + resolved);
+
+    if (m_passProfileWanted && !m_passProfileRemaining && m_passProfilePending.empty()) {
+      profileReport();
+      m_passProfileWanted = 0u;
+    }
+  }
+#endif
