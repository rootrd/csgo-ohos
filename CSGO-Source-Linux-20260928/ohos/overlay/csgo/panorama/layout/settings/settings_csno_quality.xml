<root>
	<styles>
		<include src="file://{resources}/styles/csgostyles.css" />
		<include src="file://{resources}/styles/settings/settings.css" />
		<include src="file://{resources}/styles/mainmenu.css"/>
		<include src="file://{resources}/styles/csno_touch.css"/>
	</styles>

	<scripts>
		<include src="file://{resources}/scripts/settingsmenu_shared.js" />
		<include src="file://{resources}/scripts/csno_bridge.js" />
		<include src="file://{resources}/scripts/csno_quality.js" />
	</scripts>

	<!-- CS:NO (09-28, 0.2.0): 画质预设 -- CsnoQuality.java: four tested sets of video settings (video.txt), applied
	     with one restart, so nobody tries combinations in 视频设置 until the picture goes black -->
	<Panel useglobalcontext="true" class="SettingsMenuTab" onload="CsnoQuality.Init();">
		<Panel class="SettingsMenuTabContent vscroll">
			<Panel class="SettingsBackground">
				<Panel class="SettingsSectionTitleContianer">
					<Label class="SettingsSectionTitleLabel" text="画质预设" />
				</Panel>
				<Label class="csno-row-hint" text="选一档就行，不用自己在「视频」里一项项调（乱调容易黑屏）。选好后游戏会自动重启一次生效。" />
				<Label class="csno-row-hint" text="高 ≈ 电脑上的「中」：约 1K 分辨率 + 2 倍抗锯齿 + 中等阴影。中 / 低 / 极低 依次降低分辨率；中 只留 FXAA 抗锯齿，低 和 极低 没有抗锯齿，阴影和特效都是最低。骁龙 8 至尊版选「中」可稳 120 帧。" />
				<Panel class="horizontal-separator"/>

				<Panel class="csno-row">
					<Label class="csno-row-label" text="当前画质" />
					<Label id="CsnoQualityCurrent" class="csno-value" style="width: 52%;" text="…" />
				</Panel>
				<Panel class="csno-row">
					<Label class="csno-row-label" text="推荐" />
					<Label id="CsnoQualityRec" class="csno-value" style="width: 52%;" text="…" />
				</Panel>
				<Panel class="csno-row">
					<Label class="csno-row-label" text="屏幕刷新率" />
					<Label id="CsnoQualityHz" class="csno-value" style="width: 52%;" text="…" />
				</Panel>
				<Panel class="horizontal-separator"/>

				<Panel class="csno-row">
					<Label id="CsnoQualityLabel_high" class="csno-row-label" style="width: 78%;" text="高" />
					<Button class="csno-action" onactivate="CsnoQuality.Pick( 'high' );">
						<Label class="csno-btn-text" text="用这档" />
					</Button>
				</Panel>
				<Panel class="csno-row">
					<Label id="CsnoQualityLabel_mid" class="csno-row-label" style="width: 78%;" text="中" />
					<Button class="csno-action" onactivate="CsnoQuality.Pick( 'mid' );">
						<Label class="csno-btn-text" text="用这档" />
					</Button>
				</Panel>
				<Panel class="csno-row">
					<Label id="CsnoQualityLabel_low" class="csno-row-label" style="width: 78%;" text="低" />
					<Button class="csno-action" onactivate="CsnoQuality.Pick( 'low' );">
						<Label class="csno-btn-text" text="用这档" />
					</Button>
				</Panel>
				<Panel class="csno-row">
					<Label id="CsnoQualityLabel_lowest" class="csno-row-label" style="width: 78%;" text="极低" />
					<Button class="csno-action" onactivate="CsnoQuality.Pick( 'lowest' );">
						<Label class="csno-btn-text" text="用这档" />
					</Button>
				</Panel>
				<Label id="CsnoQualityHint" class="csno-row-hint" text="" />
			</Panel>
		</Panel>
	</Panel>
</root>
